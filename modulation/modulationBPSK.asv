function [z] = modulationBPSK(m)
    nus = 10000;    % fréquence d'échantillonnage (Hz)
    fp = 200;       % fréquence porteuse (Hz)
    Db = 200;       % débit binaire (baud)
    A = 1;          % amplitude du signal
    
    Ts = 1/nus;     % période d'échantillonnage (sec)
    iim = 1i;       % unité imaginaire
    
    % --- Mapping BPSK (1 bit / symbole) ---
    % 0 -> +1 ; 1 -> -1
    Nsymb = numel(m);             
    ux = A * (1 - 2*m);           % mapping BPSK : 0→+1, 1→−1
    
    % --- Paramètres de suréchantillonnage ---
    Rs = Db;                      
    sps = round(nus/Rs);          % samples per symbol (nrepet)
    
    % --- Filtre de mise en forme : racine raised cosine ---
    span = 6;                     % durée du filtre (en symboles)
    rolloff = 0.25;               % facteur de roll-off
    pulse = rcosdesign(rolloff, span, sps, 'sqrt');  
    
    % --- Suréchantillonnage et filtrage ---
    u_tx = upfirdn(ux, pulse, sps, 1);  % mise en forme
    
    % --- Compensation du délai de groupe ---
    delay = span * sps / 2;  % décalage introduit par le filtre
    u_tx = u_tx(delay+1 : end-delay);   % suppression du retard
    
    % --- Recalcul du temps pour correspondre à u_tx ---
    Ntot = length(u_tx);
    t = (0:Ntot-1) * Ts;
    
    % --- Modulation porteuse ---
    x = real(u_tx) .* cos(2*pi*fp*t); % signal BPSK réel uniquement
    % --- Ajout de bruit ---
    sigma2 = 1;
    z = x + sqrt(sigma2)*randn(1,length(x)); % ajout de bruit blanc gaussien
end
