function y = codageCanalConv(u)
% Code convolutif (n,k,K) = (2,1,3) avec G1=111, G2=101
% A chaque bit d'entrée -> 2 bits de sortie : [y1 y2]

    if nargin < 2, addTail = true; end
    
    u = logical(u(:)');     % ligne logique
    K = 3;  m = K-1;        % longueur de contrainte et mémoire

    if addTail
        u = [u, false(1,m)];   % vidage de l'état
    end

    % Registre à décalage (s(1)=bit courant, s(2)=u(t-1), s(3)=u(t-2))
    s = false(1,K);

    N = numel(u);
    Y = false(N, 2);        % 2 sorties par bit (taux 1/2)

    for t = 1:N
        % insérer le nouveau bit en tête
        s = [u(t), s(1:end-1)];

        % G1 = 111 -> y1 = s1 ⊕ s2 ⊕ s3
        y1 = xor(xor(s(1), s(2)), s(3));

        % G2 = 101 -> y2 = s1 ⊕ s3
        y2 = xor(s(1), s(3));

        Y(t, :) = [y1, y2];
    end

    % Aplatir en vecteur ligne binaire : [y1 y2 y1 y2 ...]
    y = reshape(Y.', 1, []);
end
